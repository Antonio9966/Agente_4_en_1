# Puerto del servidor backend (opcional, por defecto 3001)
PORT=3001

# Clave API de Google Gemini (opcional - habilita extracción y síntesis avanzada por LLM)
# Si se omite, la aplicación funciona en Modo Basado en Evidencia Local sin costo de API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Clave API de Groq (opcional, gratuita/rápida con modelos Llama/Qwen)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Clave API compatible con OpenAI (opcional, alternativa a Gemini/Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Correo opcional para pool cortés ("polite pool") de OpenAlex y Crossref
ACADEMIC_POLITE_EMAIL=

# Clave opcional de Semantic Scholar para mayores límites de tasa
SEMANTIC_SCHOLAR_API_KEY=
